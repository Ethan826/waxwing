type E = E;
effect Log { fn log(n: Int): Unit; };
effect Tick { fn tick(): Unit; };
fn main(): Unit with Console = handle {
  with handler Tick { tick() => {
      let mk = fn(g) => handler Log { log(n) => g(n) };
      let h = mk(fn(n: Int) => fail(E));
      with h { log(1) }
    } } { tick() }
} { fail(error: E) => print(9) };
