  let k = fn(u: Unit) => ();
  let h = handler Log { log(n) => () };
  let g1 = fn(u: Unit) => with h { let v = No; if put(v) then print(v == v) else
() };
  let g2 = fn(u: Unit) => { k(()); if put(Some(true)) then () else () };
  print(0)
