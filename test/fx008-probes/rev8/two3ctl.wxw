effect Log { fn log(n: Int): Unit; };
effect Tick { fn tick(): Unit; };
effect Get(a) { fn get(): a; };
fn main(): Unit with Console = {
  let k = fn(u: Unit) => ();
  let h1 = handler Tick { tick() => k(()) };
  let h2 = handler Tick { tick() => () };
  with handler Get(Handler(Log with Console)) { get() => handler Log { log(n) =>
Console.print(n) } } { with h1 { Tick.tick() } };
  let g = fn(u: Unit) => with h2 { with Get.get() { Log.log(1) } };
  Console.print(0)
};
