type Opt(a) = No | Some(a);
effect Log { fn log(n: Int): Unit; };
effect Cell(a) { fn put(x: a): Bool; };
fn main(): Unit with Console = {
  let k = fn(u: Unit) => ();
  let h = handler Log { log(n) => k(()) };
  let g1 = fn(u: Unit) => with h { let v = No;
    if Cell.put(v) then Console.print(v == v) else
() };
  let g2 = fn(u: Unit) => { k(()); if Cell.put(Some(true)) then () else () };
  let h3 = handler Log { log(n) => () };
  let g3 = fn(u: Unit) => { k(()); with h3 { () } };
  let g4 = fn(u: Unit) => with h3 { let w = No;
    if Cell.put(w) then Console.print(w == w)
else () };
  Console.print(0)
};
