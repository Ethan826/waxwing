type Opt(a) = No | Some(a);
effect Log { fn log(n: Int): Unit; };
effect Cell(a) { fn put(x: a): Bool; };
fn main(): Unit with Console = {
  let k = fn(u: Unit) => ();
  let h1 = handler Log { log(n) => k(()) };
  let h2 = handler Log { log(n) => k(()) };
  let g1 = fn(u: Unit) => with h1 { let v = No; if Cell.put(v) then Console.print(v == v)
else () };
  let g2 = fn(u: Unit) => with h2 { if Cell.put(Some(true)) then () else () };
  Console.print(0)
};
