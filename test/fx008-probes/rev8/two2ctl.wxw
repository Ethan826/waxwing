type Opt(a) = No | Some(a);
effect Log { fn log(n: Int): Unit; };
effect Cell(a) { fn put(x: a): Unit; };
fn main(): Unit with Console = {
  let k = fn(u: Unit) => ();
  let h1 = handler Log { log(n) => k(()) };
  let h2 = handler Log { log(n) => () };
  let g1 = fn(u: Unit) => with h1 { Cell.put(No) };
  let g2 = fn(u: Unit) => with h2 { Cell.put(Some(true)) };
  Console.print(0)
};
