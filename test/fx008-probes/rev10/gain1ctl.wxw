effect Log { fn log(n: Int): Unit; };
effect Cell(a) { fn put(x: a): Bool; };
fn main(): Unit with Console = {
  let k = fn(u: Unit) => ();
  let k2 = fn(u: Unit) => ();
  let h = handler Log { log(n) => k2(()) };
  let g = fn(u: Unit) => { if put(true) then () else (); with h { log(1) } };
  k(());
  print(0)
};
