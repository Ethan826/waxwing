effect Log { fn log(n: Int): Unit; };
effect Tick { fn tick(): Unit; };
fn main(): Unit with Console = {
  let k = fn(u: Unit) => ();
  let h0 = handler Tick { tick() => () };
  let h2 = handler Log { log(n) => k(()) };
  let h1 = handler Log { log(n) => with h0 { k(()) } };
  with h1 { Log.log(1) };
  Console.print(0)
};
