type E = E;
effect Log { fn log(n: Int): Unit; };
effect Cell(a) { fn put(x: a): Unit; };
fn main(): Unit with Console = {
  let g = fn(n: Int) => ();
  let h = handler Log { log(n) => g(n) };
  let z = fn(u: Unit) => {
    put(g);
    defer put(fn(n: Int) => fail(E));
    ()
  };
  with h { log(1) }
