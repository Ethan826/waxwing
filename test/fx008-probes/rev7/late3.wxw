  let k = fn(u: Unit) => ();
  let h = handler Log { log(n) => k(()) };
  let g1 = fn(u: Unit) => with h { let v = No; if Cell.put(v) then Console.print(v == v) else
() };
  with handler Cell(Opt(Bool)) { put(x) => true } { k(()) };
  ()
