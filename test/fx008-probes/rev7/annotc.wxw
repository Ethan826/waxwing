type E = E;
effect Log { fn log(n: Int): Unit; };
effect Tick { fn tick(): Unit; };
fn main(): Unit with Console = handle {
  let h = handler Log { log(n) => Console.print(n) };
  let inst = fn(x: Handler(Log)) => { with x { Log.log(1) }; defer Tick.tick(); () };
  with handler Tick { tick() => Console.print(5) } { inst(h) };
  with handler Tick { tick() => Fail.fail(E) } { with h { Tick.tick() } }
} { fail(error: E) => Console.print(9) };
