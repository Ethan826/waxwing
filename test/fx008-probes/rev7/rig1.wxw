effect Log { fn log(n: Int): Unit; };
effect Tick { fn tick(): Unit; };
fn f(cb: Unit -> Unit with ...e): Unit with Tick + ...e = {
  let h = handler Log { log(n) => cb(()) };
  let g = fn(u: Unit) => with h { Log.log(1) };
  let g2 = fn(u: Unit) => { g(()); Tick.tick() };
  g2(())
};
fn main(): Unit with Console =
  with handler Tick { tick() => Console.print(2) } { f(fn(u: Unit) => Console.print(1)) };
