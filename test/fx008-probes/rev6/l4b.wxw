type E = E;
effect Log { fn log(n: Int): Unit; };
fn main(): Unit with Console = handle {
  let k = fn(u: Unit) => ();
  let g = fn(u: Unit) => { k(()); defer log(0); () };
  with handler Log { log(n) => print(n) } { g(()) };
  with handler Log { log(n) => fail(E) } { k(()) }
} { fail(error: E) => print(9) };
