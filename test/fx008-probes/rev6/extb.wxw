type E = E;
effect Log { fn log(n: Int): Unit; };
fn main(): Unit with Console = handle {
  let fwd = handler Log { log(n) => Log.log(n + 10) };
  let g = fn(u: Unit) => { with fwd { Log.log(2) }; defer Log.log(0); () };
  with handler Log { log(n) => Console.print(n) } { g(()) };
  with handler Log { log(n) => Fail.fail(E) } { with fwd { Log.log(1) } }
} { fail(error: E) => Console.print(9) };
