type E = E;
effect Log { fn log(n: Int): Unit; };
fn main(): Unit with Console = {
  let k = fn(u: Unit) => ();
  let g = fn(u: Unit) => { k(()); defer Log.log(0); () };
  handle { with handler Log { log(n) => Fail.fail(E) } { k(()) } } {
    fail(error: E)
=> Console.print(9) };
  with handler Log { log(n) => Console.print(n) } { g(()) }
};
