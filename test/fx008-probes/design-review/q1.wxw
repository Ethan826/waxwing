type E = E;
effect Log { fn log(n: Int): Unit; };
fn prefix(): Handler(Log with Log) with pure = handler Log { log(n) => Log.log(n +
100) };
fn run(h: Handler(Log with Log + ...e)): Unit with Log + ...e = { defer Log.log(0);
with h { Log.log(1) } };
fn main(): Unit with Console =
  handle {
    with handler Log { log(n) => Console.print(n) } { with prefix() { defer Log.log(1); () }
};
    with handler Log { log(n) => Console.print(n) } { run(prefix()) };
    with handler Log { log(n) => Fail.fail(E) } { with prefix() { Log.log(3) } }
  } { fail(error: E) => Console.print(9) };
