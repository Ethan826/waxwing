type E = E;
effect Log { fn log(n: Int): Unit; };
fn main(): Unit with Console =
  handle {
    let k = fn(n: Int) => Log.log(n);
    with handler Log { log(n) => Console.print(n) } { defer Log.log(1); k(2) };
    with handler Log { log(n) => Fail.fail(E) } { k(3) }
  } { fail(error: E) => Console.print(9) };
