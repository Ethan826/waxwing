type E = E;
effect Log { fn log(n: Int): Unit; };
fn main(): Unit with Console =
  handle {
    let fwd = handler Log { log(n) => Log.log(n + 10) };
    with handler Log { log(n) => Console.print(n) } { with fwd { defer
      Log.log(1); () } };
    with handler Log { log(n) => Fail.fail(E) } { with fwd { Log.log(3) } }
  } { fail(error: E) => Console.print(9) };
