effect Log { fn log(n: Int): Unit; };
effect Tick { fn tick(): Unit; };
fn main(): Unit with Console = {
  let k = fn(n: Int) => Console.print(n);
  with handler Tick { tick() => Console.print(0) } {
    let h = handler Log { log(n) => { defer k(n); () } };
    k(1);
    with h { Log.log(2) }
  }
};
