fn join(a: { ...r }, b: { ...s }): { ...r, ...s }
  where r disjoint s =
  { ...a, ...b };

fn composeRequirements(
  make: (a, b) -> { x: Int, y: Int },
  use: (a, b) -> Int
): Int = 0;

fn restricted(p: { ...u }, q: { ...v }): Int
  where u lacks { y }, v lacks { x } =
  0;

fn main(): Int =
  composeRequirements(
    fn(p: { x: Int }, q) => join(p, q),
    restricted
  );
