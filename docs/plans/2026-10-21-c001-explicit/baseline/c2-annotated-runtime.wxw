type Pair(a, b) = Pair(a, b);
type Results = Results(Pair(Int, Int), Pair(Int, Int), Int);

fn add(x: Int, y: Int): Int = x + y;

fn smallProduct(x: Int, y: Int): Int =
  if y == 0 then 0 else x + smallProduct(x, y + -1);

fn sum(): { combine: (Int, Int) -> Int with pure } = { combine: add };

fn product(): { combine: (Int, Int) -> Int with pure } =
  { combine: smallProduct };

fn lastFor(): { combine: (a, a) -> a with pure } =
  { combine: fn(x, y) => y };

fn client(d: { combine: (a, a) -> a with pure }, x: a, y: a): a =
  d.combine(x, y);

fn configured(d: { combine: (a, a) -> a with pure }):
    (a, a) -> a with pure = fn(x: a, y: a) => client(d, x, y);

fn choose(flag: Bool): { combine: (Int, Int) -> Int with pure } =
  if flag then sum() else product();

fn reverse(d: { combine: (a, a) -> a with pure }):
    { combine: (a, a) -> a with pure } =
  { combine: fn(x: a, y: a) => d.combine(y, x) };

fn runtime(flag: Bool): Pair(Int, Int) =
  Pair(configured(choose(flag))(2)(3), configured(lastFor())(2)(3));

fn main(): Results = Results(runtime(true), runtime(false),
  configured(reverse(lastFor()))(2)(3));
